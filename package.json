{
    "name": "react-lab",
    "type": "module",
    "version": "1.0.0",
    "private": true,
    "packageManager": "bun",
    "description": "React Lab Experiments",
    "author": {
        "name": "Dhanny Pramana",
        "email": "p.dhannyprmana@gmail.com"
    },
    "keywords": [
        "react-lab",
        "react",
        "lab"
    ],
    "engines": {
        "node": ">=24.13.0",
        "bun": ">=1.3.8"
    },
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "preview": "vite preview",
        "prepare": "husky",
        "commit": "cz",
        "bump:major": "npm --no-git-tag-version version major",
        "bump:minor": "npm --no-git-tag-version version minor",
        "bump:patch": "npm --no-git-tag-version version patch"
    },
    "dependencies": {
        "@tailwindcss/vite": "^4.3.1",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "tailwindcss": "^4.3.1"
    },
    "devDependencies": {
        "@antfu/eslint-config": "^9.1.0",
        "@commitlint/cli": "^21.1.0",
        "@commitlint/config-conventional": "^21.1.0",
        "@eslint-react/eslint-plugin": "^5.9.2",
        "@eslint/js": "^10.0.1",
        "@types/node": "^24.13.2",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.2",
        "commitizen": "^4.3.2",
        "commitlint-config-cz": "^0.13.3",
        "cz-conventional-changelog": "^3.3.0",
        "eslint": "^10.5.0",
        "eslint-plugin-format": "^2.0.1",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.3",
        "globals": "^17.6.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.0.8",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.61.0",
        "unplugin-auto-import": "^21.0.0",
        "vite": "^8.1.0"
    },
    "lint-staged": {
        "*": "eslint --fix"
    }
}
